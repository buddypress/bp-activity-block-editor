	"bugs": {
		"url": "https://github.com/buddypress/bp-activity-block-editor/issues"
	},
	"homepage": "https://github.com/buddypress/bp-activity-block-editor#readme",
	"devDependencies": {
		"@wordpress/scripts": "^30.0.2",
		"@wordpress/babel-preset-default": "^8.8.2",
